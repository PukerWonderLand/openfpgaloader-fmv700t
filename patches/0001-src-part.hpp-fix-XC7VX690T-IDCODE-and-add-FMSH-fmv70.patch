From 26638aeb5529a7d6d02804c15b0ec65bbf285985 Mon Sep 17 00:00:00 2001
From: YangHao <44292772+PukerWonderLand@users.noreply.github.com>
Date: Wed, 14 Oct 2026 15:58:11 +0800
Subject: [PATCH] src/part.hpp: fix XC7VX690T IDCODE and add FMSH fmv700t

The XC7VX690T entry uses 0x33691093, whose highest nibble (version) is
non-zero and therefore contradicts the "Highest nibble (version) must
always be set to 0" rule stated at the top of this file. Per UG470
Table 1-1 the correct IDCODE is 0x03691093.

Also add the FMSH fmv700t (0x02291143), a 7-series-compatible device
sharing the XC7VX690T's JTAG interface and configuration frame format.

Tested on hardware: --detect identifies it and SRAM configuration
reaches DONE.

Signed-off-by: YangHao <44292772+PukerWonderLand@users.noreply.github.com>
---
 src/part.hpp | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/src/part.hpp b/src/part.hpp
index 6b28741..169ccab 100644
--- a/src/part.hpp
+++ b/src/part.hpp
@@ -103,7 +103,10 @@ static std::map <uint32_t, fpga_model> fpga_list = {
 	{0x03682093, {"xilinx", "virtex7", "xc7vx415t",   6}},
 	{0x03687093, {"xilinx", "virtex7", "xc7vx485t",   6}},
 	{0x03692093, {"xilinx", "virtex7", "xc7vx550t",   6}},
-	{0x33691093, {"xilinx", "virtex7", "xc7vx690t",   6}},
+	{0x03691093, {"xilinx", "virtex7", "xc7vx690t",   6}},
+	/* FMSH (Shanghai Fudan Microelectronics) fmv700t: Xilinx-compatible 7-series
+	 * device with the same JTAG IR length and instruction set as the XC7VX690T. */
+	{0x02291143, {"xilinx", "virtex7", "xc7vx690t",   6}},
 	{0x03696093, {"xilinx", "virtex7", "xc7vx980t",   6}},
 
 	{0x036d9093, {"xilinx", "virtex7", "xc7vh580t",  22}},
